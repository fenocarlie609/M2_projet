# Exemple de configuration du serveur. Ce fichier ne contient aucune valeur
# reelle et peut etre versionne. Copiez-le en .env puis remplacez les valeurs.
#
#   cp .env.example .env

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Base de donnees PostgreSQL
DATABASE_URL=postgresql://gestion:gestion@localhost:5432/gestion

# Secrets : a remplacer par des valeurs longues et aleatoires.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
COOKIE_SECRET=remplacer-par-un-secret-fort
JWT_SECRET=remplacer-par-un-secret-fort
JWT_REFRESH_SECRET=remplacer-par-un-secret-fort

# Durees de validite des jetons
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Niveau de detail des journaux
LOG_LEVEL=info
