// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums pour qualifier le type d'entité métier
enum EntityType {
  COMPANY      // Entreprise / Personne Morale
  INDIVIDUAL   // Particulier / Personne Physique
}

enum ClientAddressType {
  BILLING
  DELIVERY
  BOTH
}

// ==========================================
// 1. ARCHITECTURE INTERNE (EMPLOYÉS & ACCÈS)
// ==========================================

model Department {
  id          String     @id @default(uuid())
  code        String     @unique // Ex: "LOGISTICS", "ADMIN", "FINANCE", "TECH", "COMMERCIAL" (correspond à companyStructure.js)
  label       String     // Ex: "Logistique & Opérations Maritimes"

  positions   Position[]
  employees   Employee[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?  // Soft delete pour le département

  @@index([deletedAt])
  @@map("departments")
}

model Position {
  id            String     @id @default(uuid())
  code          String     @unique // Ex: "QUAY_AGENT", "HR_MGR" (unique globalement, comme dans companyStructure.js)
  label         String     // Ex: "Agent de quai"

  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  employees     Employee[]

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?  // Soft delete pour le poste

  // Clé unique composite : permet à Employee de référencer (positionId + departmentId)
  // ensemble, et garantit ainsi qu'un employé ne peut pas être rattaché à une position
  // qui n'appartient pas au département déclaré.
  @@unique([id, departmentId])
  @@index([deletedAt])
  @@map("positions")
}

model Employee {
  id            String    @id @default(uuid())

  // Informations Personnelles & Professionnelles
  name          String    // Nom complet
  cin           String?   @unique // Numéro CIN (optionnel : certains employés n'en ont pas encore)
  matricule     String    @unique // Numéro de matricule interne (attribué par la RH), utilisable pour se connecter
  phone         String?
  avatarUrl     String?   // Photo de l'employé

  // Un employé a UNE seule position, elle-même rattachée à UN seul département.
  // On stocke aussi departmentId directement (dénormalisé) pour permettre la
  // contrainte de clé étrangère composite ci-dessous.
  departmentId  String
  positionId    String
  department    Department @relation(fields: [departmentId], references: [id])
  position      Position   @relation(fields: [positionId, departmentId], references: [id, departmentId])

  // --- SECTION COMPTE & ACCÈS À L'APPLICATION ---
  hasAppAccess  Boolean   @default(false) // Permet de marquer si l'employé a le droit d'utiliser l'app
  email         String?   @unique // Requis uniquement si hasAppAccess = true
  password      String?   // Requis uniquement si hasAppAccess = true
  isActive      Boolean   @default(false) // Si le compte est activé/validé par l'admin

  // Relations
  permissions   EmployeePermission[] // Liste des permissions spécifiques de cet employé
  auditLogs     AuditLog[]
  notificationRead NotificationRead[]
  refreshTokens RefreshToken[]
  validatedLoadingPlans LoadingPlan[] @relation("LoadingPlanValidator")
  loadedCargoLines CargoLine[] @relation("CargoLineLoader")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? // Soft delete pour l'employé

  @@map("employees")
}

model AppModule {
  id        String   @id @default(uuid())
  code      String   @unique // Ex: "EMPLOYEES", "USERS", "DEPARTMENTS", "*" (tous modules)
  label     String   // Ex: "Employés", "Utilisateurs & Accès"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_modules")
}

model EmployeePermission {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  module      String   // Le module visé (Ex: "CHARGEMENT", "AUDIT", "EMPLOYEES")
  action      String   // L'action autorisée (Ex: "CREATE", "READ", "UPDATE", "DELETE")

  @@unique([employeeId, module, action]) // Évite les doublons de permissions pour un même employé
  @@map("employee_permissions")
}

model AuditLog {
  id          String    @id @default(uuid())
  employeeId  String?   // Remplacé userId par employeeId
  employee    Employee? @relation(fields: [employeeId], references: [id])

  action      String    // Ex: "LOADING_PLAN_CREATE"
  method      String    // GET, POST, PUT, DELETE
  route       String
  ipAddress   String
  payload     Json?
  oldValues   Json?
  newValues   Json?

  createdAt   DateTime  @default(now())

  @@map("audit_logs")
}

// ==========================================
// 2. DONNÉES MÉTIERS (EXTERNES)
// ==========================================

model Client {
  id                   String          @id @default(uuid())
  reference            String?         @unique
  name                 String
  type                 EntityType      @default(INDIVIDUAL)

  // Identite d'un particulier
  firstName            String?
  lastName             String?
  cin                  String?         @unique
  cinIssuedAt          DateTime?
  cinIssuedPlace       String?

  // Identite d'une entreprise
  legalName            String?
  tradeName            String?
  nif                  String?         @unique
  stat                 String?         @unique
  rcs                  String?
  legalForm            String?
  activity             String?

  // Coordonnees et conditions commerciales
  email                String?
  phone                String?
  secondaryPhone       String?
  paymentTerms         String?
  currency             String          @default("MGA")
  taxExempt            Boolean         @default(false)
  taxExemptionReason   String?
  contractNumber       String?
  habitualCargoType    String?

  // Personne responsable de la reception
  receptionContactName  String?
  receptionContactPhone String?
  receptionContactEmail String?

  isActive             Boolean         @default(true)
  notes                String?
  cargoLines           CargoLine[]
  addresses            ClientAddress[]
  documents            ClientDocument[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  deletedAt            DateTime?

  @@index([type])
  @@index([name])
  @@index([deletedAt])

  @@map("clients")
}

model ClientAddress {
  id           String            @id @default(uuid())
  clientId     String
  type         ClientAddressType
  label        String?
  addressLine1 String
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  country      String            @default("Madagascar")
  isDefault    Boolean           @default(false)

  client       Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?

  @@index([clientId, type])
  @@index([deletedAt])
  @@map("client_addresses")
}

model ClientDocument {
  id           String   @id @default(uuid())
  clientId     String
  documentType String
  documentNumber String?
  fileName     String?
  fileUrl      String?
  issuedAt     DateTime?
  expiresAt    DateTime?
  verifiedAt   DateTime?
  notes        String?

  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@index([clientId, documentType])
  @@index([expiresAt])
  @@index([deletedAt])
  @@map("client_documents")
}

model Driver {
  id           String     @id @default(uuid())
  name         String
  type         EntityType @default(INDIVIDUAL)
  licensePlate String
  phone        String?
  cargoLines   CargoLine[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("drivers")
}

// ==========================================
// 3. DONNÉES MARITIMES
// ==========================================

model Vessel {
  id                   String   @id @default(uuid())
  name                 String
  operatorName         String?
  registrationNumber   String?  @unique
  capacityTons         Decimal?
  status               String   @default("ACTIVE")

  voyages              Voyage[]

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  deletedAt            DateTime?

  @@index([status])
  @@index([deletedAt])
  @@map("vessels")
}

model Port {
  id                   String   @id @default(uuid())
  code                 String   @unique
  name                 String
  country              String?

  departureVoyages     Voyage[] @relation("DeparturePort")
  arrivalVoyages       Voyage[] @relation("ArrivalPort")

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  deletedAt            DateTime?

  @@index([deletedAt])
  @@map("ports")
}

model Voyage {
  id                   String   @id @default(uuid())
  vesselId             String
  departurePortId      String
  arrivalPortId        String
  voyageNumber         String
  departureDate        DateTime?
  arrivalDate          DateTime?
  status               String   @default("DRAFT")

  vessel               Vessel   @relation(fields: [vesselId], references: [id])
  departurePort        Port     @relation("DeparturePort", fields: [departurePortId], references: [id])
  arrivalPort          Port     @relation("ArrivalPort", fields: [arrivalPortId], references: [id])
  loadingPlans         LoadingPlan[]

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  deletedAt            DateTime?

  @@unique([vesselId, voyageNumber])
  @@index([departurePortId])
  @@index([arrivalPortId])
  @@index([status])
  @@index([deletedAt])
  @@map("voyages")
}

model Vehicle {
  id                   String   @id @default(uuid())
  licensePlate         String   @unique
  type                 String?
  capacityTons         Decimal?
  status               String   @default("ACTIVE")

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  deletedAt            DateTime?
  cargoLines           CargoLine[]

  @@index([status])
  @@index([deletedAt])
  @@map("vehicles")
}

model LoadingPlan {
  id             String   @id @default(uuid())
  reference      String   @unique
  voyageId       String
  status         String   @default("DRAFT")
  totalWeightKg  Decimal  @default(0)
  validatedAt    DateTime?
  validatedById  String?

  voyage         Voyage   @relation(fields: [voyageId], references: [id])
  validatedBy    Employee? @relation("LoadingPlanValidator", fields: [validatedById], references: [id])
  cargoLines     CargoLine[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  @@index([voyageId])
  @@index([status])
  @@index([deletedAt])
  @@map("loading_plans")
}

model CargoLine {
  id             String   @id @default(uuid())
  loadingPlanId  String
  clientId       String
  driverId       String?
  vehicleId      String?
  loadedById     String?
  loadingDate    DateTime?
  packageCount   Int
  description    String
  weightKg       Decimal
  anomaly        String?
  loadingPosition String?
  isHazardous    Boolean  @default(false)
  status         String   @default("PENDING")

  loadingPlan    LoadingPlan @relation(fields: [loadingPlanId], references: [id], onDelete: Cascade)
  client         Client      @relation(fields: [clientId], references: [id])
  driver         Driver?     @relation(fields: [driverId], references: [id])
  vehicle        Vehicle?    @relation(fields: [vehicleId], references: [id])
  loadedBy       Employee?   @relation("CargoLineLoader", fields: [loadedById], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  @@index([loadingPlanId])
  @@index([clientId])
  @@index([loadingDate])
  @@index([status])
  @@index([deletedAt])
  @@map("cargo_lines")
}

model Notification {
  id           String             @id @default(uuid())
  type         String             // Ex: "ACCESS_REQUEST"
  message      String
  payload      Json?              // Contexte structuré, ex: { "employeeId": "..." }

  // Ciblage par permission plutôt que par personne : toute permission
  // (targetModule, targetAction) ou son wildcard rend la notification visible.
  // targetModule = null -> notification globale (vue par tout le monde).
  targetModule String?
  targetAction String?

  createdAt    DateTime           @default(now())
  reads        NotificationRead[]

  @@map("notifications")
}

model NotificationRead {
  id             String       @id @default(uuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([notificationId, employeeId])
  @@map("notification_reads")
}

model RefreshToken {
  id               String    @id @default(uuid())
  employeeId       String
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tokenHash        String    @unique
  familyId         String
  jti              String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?
  replacedByTokenId String?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([employeeId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}